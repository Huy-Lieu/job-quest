# .env.example — commit this file, it contains NO real secrets

# App URL (used by cron job to call internal endpoints)
NEXT_PUBLIC_URL=http://localhost:3000   # set to your Vercel URL in production

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Job Search — Apify (https://console.apify.com → Settings → Integrations)
APIFY_TOKEN=apify_api_your-token-here

# Cron Security (generate: openssl rand -base64 32)
CRON_SECRET=generate-with-openssl-rand-base64-32

# Google Drive OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=